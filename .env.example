# Compose project name (shares existing external volumes & network when named nbf-lite)
COMPOSE_PROJECT_NAME=nbf-lite

# Path to Fabric middleware & runtime vars/wallets (default uses self-contained ./fabric)
SERVERS_DIR=./fabric

# Path to external compiled NBF Academia binaries (>50 MB, excluded from git)
NBF_LITE_DIR=/path/to/NBF-Lite

